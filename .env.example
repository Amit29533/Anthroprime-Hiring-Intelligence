VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Netlify Function variables. Do not prefix R2 credentials with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Scheduled workers and optional audited document signing. Never add VITE_ to this secret.
SUPABASE_SERVICE_ROLE_KEY=
# Optional AI, server-only. Workspace AI remains disabled until an admin enables it.
OPENAI_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
# Set a Responses-compatible model explicitly before enabling draft generation.
AI_DRAFT_MODEL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=anthroprime-documents

# VirusTotal reputation lookup only: never uploads CVs. Server-only secrets.
# Requires an account licensed for this commercial business workflow.
VIRUSTOTAL_API_KEY=
# Set to commercial only after confirming your account's permitted usage.
VIRUSTOTAL_USAGE_TIER=
# Optional LinkedIn-ID candidate enrichment (server-only; never VITE_ prefixed).
# Also enable the workspace option in the candidate import dialog after migration.
LINKEDIN_ENRICHMENT_ENABLED=false
PEOPLEDATALABS_API_KEY=

# Optional fictional delivery callback verification, server-only, at least 32 characters.
# Basic sandbox dispatch needs no sender/provider key. Never use a VITE_ prefix.
DELIVERY_SANDBOX_CALLBACK_SECRET=

# Stage 3 Google Workspace OAuth and server-encrypted credential custody. Never VITE_ prefix.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exactly 64 hexadecimal characters (32 random bytes), backed up outside the deployment.
GOOGLE_CREDENTIAL_KEY=
# Exact HTTPS application origin, no path/query. OAuth redirect is /.netlify/functions/google-oauth-callback.
GOOGLE_APP_ORIGIN=
