VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Netlify Function variables. Do not prefix R2 credentials with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Phase 3 scheduled worker only. Never add VITE_ to this secret.
SUPABASE_SERVICE_ROLE_KEY=
# Optional AI, server-only. Workspace AI remains disabled until an admin enables it.
OPENAI_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
# Set a Responses-compatible model explicitly before enabling draft generation.
AI_DRAFT_MODEL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=anthroprime-documents
