# Operator host only. Never put these values in VITE variables or browser settings.
# Use a separately stored, cryptographically random 32-byte key (64 hex characters).
RECOVERY_KEY_HEX=
# Native libpq service/password files: private permissions, require verified TLS for remote DBs.
PGSERVICEFILE=
PGPASSFILE=
PGSSLMODE=verify-full
# Existing server worker credentials, same names as scanner/.env.example.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
